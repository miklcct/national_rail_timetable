                ? array_reduce(range($j, $j + $colspan - 1), fn($carry, $item) => $carry || $calls[0][$item]->isValidConnection($this->query->timeType, $this->query->connectingTime, $this->query->connectingToc), false)
                    ? 'valid_connection'
                    : 'invalid_connection'
                : '';
            if (
                $i !== 0
                && isset($calls[$i][$j])
                && $board->isCallOvertaken(
