/**
 * @param ServiceCall[] $array
 * @param int $i
 * @return int
 */
function get_colspan(array $array, int $i) : int {
    $call = $array[$i];
    $colspan = 0;
    /** @noinspection TypeUnsafeComparisonInspection */
    while (
        isset($array[$i])
        && $array[$i]->service->uid === $call->service->uid
        && $array[$i]->callIndex == $call->callIndex
    ) {
        ++$colspan;
        ++$i;
    }
    return $colspan;
}

/** @var TimetableView $this */
foreach ($this->boards as $board) {
    $timetable = Timetable::generateFromBoard($board);
    $stations = $timetable->stations;
    $calls = $timetable->calls;

    $destinations = $board->getDestinations();
    // if the via point is a destination don't show it
    $via = $board->getViaPoint();
    if (array_find($destinations, static fn(Location $location) => $location->getCrsOrTiplocCode() === $via?->getCrsOrTiplocCode())) {
        $via = null;
    }
    $shown_stations = $this->getShownRows($timetable);
?>
        <section>
            <h2>Trains
                <?= $this->query->timeType->isArrival() && $destinations ? ' from ' . html(implode(', ', array_map(static fn(Location $location) => $location->getShortName(), $destinations))) : '' ?>
